# Gemini API key (tried first) — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter API key (fallback if every Gemini model fails) — https://openrouter.ai/keys
OPENROUTER_KEY=

# Optional — port the backend listens on (default 8787)
PORT=8787

# Optional — sent to OpenRouter as the HTTP-Referer header
# (default http://localhost:5173). In production, set to your deployed
# frontend's URL, e.g. https://your-site.netlify.app
APP_URL=

# Optional — restricts CORS to one origin (your deployed frontend's URL).
# Leave blank in local dev to allow any origin.
CORS_ORIGIN=

# Optional — rate limit for the /api routes, per visitor IP: at most
# RATE_LIMIT_MAX requests every RATE_LIMIT_WINDOW_MIN minutes
# (defaults 30 and 15; one contract uses 3 requests). /health is not limited.
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_MIN=15

# Optional — number of proxies in front of the backend, so the rate limit sees
# each visitor's real IP. Set to 1 on Render. Leave unset in local dev.
# TRUST_PROXY=1
