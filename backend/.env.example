# OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_KEY=

# Optional — port the backend listens on (default 8787)
PORT=8787

# Optional — sent to OpenRouter as the HTTP-Referer header
# (default http://localhost:5173). In production, set to your deployed
# frontend's URL, e.g. https://your-site.netlify.app
APP_URL=

# Optional — restricts CORS to one origin (your deployed frontend's URL).
# Leave blank in local dev to allow any origin.
CORS_ORIGIN=
